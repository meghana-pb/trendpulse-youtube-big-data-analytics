# ============================================================
# TrendPulse - Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=trendpulse
POSTGRES_USER=trendpulse_user
POSTGRES_PASSWORD=your_secure_password_here

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=youtube-trending-events
KAFKA_GROUP_ID=trendpulse-consumer-group
KAFKA_AUTO_OFFSET_RESET=earliest

# --- HDFS ---
HDFS_NAMENODE_HOST=localhost
HDFS_NAMENODE_PORT=9000
HDFS_BASE_PATH=/youtube-trending

# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Dataset ---
DATASET_PATH=data/raw/USvideos.csv
CATEGORY_JSON_PATH=data/raw/US_category_id.json

# --- Kafka Producer ---
PRODUCER_DELAY_SECONDS=0.05
PRODUCER_BATCH_SIZE=100

# --- FastAPI ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Demo Mode ---
DEMO_SAMPLE_SIZE=1000
